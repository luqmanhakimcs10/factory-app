# Copy to .env and fill in from the Supabase project dashboard
# (Project Settings -> API). Never commit the real .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Testing on a physical phone against a LOCAL Supabase stack (`supabase start`)?
# A phone cannot reach 127.0.0.1 — that address is the phone itself. Point
# SUPABASE_URL at this machine's LAN address instead, on the API port from
# supabase/config.toml (54321 by default):
#
#   SUPABASE_URL=http://192.168.x.x:54321
#
# Run `npm run lan-ip` to find the right address. Do not commit it — .env is
# gitignored, and the address changes with the network. Leave this commented
# out when using the hosted project; that URL works from any network already.
